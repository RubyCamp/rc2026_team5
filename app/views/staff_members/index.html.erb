<% content_for :title, "スタッフ一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    スタッフ管理
  </p>

  <h1 class="display-6 fw-bold">
    スタッフ一覧
  </h1>

  <p class="page-lead text-body-secondary">
    在籍状況・スキル・勤務可否を確認できます。
  </p>
</div>

<% if @staff_members.any? %>
  <div class="row g-4">
    <% @staff_members.each do |staff_member| %>
      <div class="col-12 col-md-6">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <span class="badge text-bg-secondary mb-3">
              <%= enum_label(
                    staff_member,
                    :employment_status
                  ) %>
            </span>

            <h2 class="h5 card-title">
              <%= staff_member.name %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>スキル</dt>
                <dd>
                  <%= staff_member.skills
                        .map(&:name)
                        .join("、")
                        .presence || "なし" %>
                </dd>
              </div>

              <div>
                <dt>勤務予定</dt>
                <dd>
                  <% if staff_member.availabilities.any? %>
                    <ul class="list-unstyled mb-0">
                      <% staff_member.availabilities.each do |availability| %>
                        <li class="mb-1">
                          <span class="badge text-bg-secondary">
                            <%= enum_label(availability, :status) %>
                          </span>
                          <%= l availability.starts_at, format: :short %>
                          〜
                          <%= l availability.ends_at, format: :short %>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    未登録
                  <% end %>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    スタッフはまだ登録されていません。
  </div>
<% end %>
