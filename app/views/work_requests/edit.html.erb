<% content_for :title, "勤務依頼の備考を編集" %>

<p>
  <%= link_to(
        "勤務依頼詳細へ戻る",
        work_request_path(@work_request),
        class: "link-secondary"
      ) %>
</p>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">勤務調整</p>
  <h1 class="display-6 fw-bold">勤務依頼の備考を編集</h1>
  <p class="page-lead text-body-secondary"><%= @work_request.title %></p>
</div>

<section class="card shadow-sm">
  <div class="card-body">
    <% if @work_request.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <p class="fw-semibold">備考を保存できませんでした。</p>
        <ul class="mb-0"><% @work_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form_with model: @work_request, class: "vstack gap-3" do |form| %>
      <div>
        <%= form.label :notes, "備考", class: "form-label" %>
        <%= form.text_area :notes, rows: 6, class: "form-control" %>
      </div>
      <div><%= form.submit "保存する", class: "btn btn-primary" %></div>
    <% end %>
  </div>
</section>
