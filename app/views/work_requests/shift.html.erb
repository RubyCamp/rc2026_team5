<% content_for :title, "シフト表" %>

<table border="1">
    <tr>
      <th></th>
      <% @work_requests.each do |work_request| %>
        <th><%= l work_request.starts_at, format: :short %></th>
      <% end %>
      </tr>
    <% @staff_members.each do |staff_member| %>

      <tr>
        <th><%= staff_member.name %></th>
        <% @work_requests.each do |work_request| %>
          <% if staff_member.id == work_request.assignments.staff_member_id %>
          <th><%= work_request.business.name %></th>
          <% end %>
        <% end %>
      </tr>
    <% end %>
</table>
