<% content_for :title, "シフト表" %>
<!-- ---------------デザインの調整 2026/09/02-------------hara -->
<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    シフト調整
  </p>

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <h1 class="display-6 fw-bold mb-0">シフト表</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exportModal">
      エクスポート
    </button>
  </div>


</div>
<div class="shift-table-wrapper table-responsive rounded-4 border">
  <table class="shift-table table table-bordered text-center align-middle mb-0">
    <thead>
      <tr>
        <th class="shift-table__staff-header"></th>
        <% @time_slot_groups.each do |date, slots| %>
          <th class="shift-table__date-header" colspan="<%= slots.size %>"><%= date.strftime("%-m/%-d") %></th>
        <% end %>
      </tr>
      <tr>
        <th class="shift-table__staff-header"></th>
        <% @time_slots.each do |slot| %>
          <th class="shift-table__time-header"><%= slot.strftime("%H:%M~") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @shift_rows.each do |row| %>
        <tr>
          <th class="shift-table__staff-header"><%= row[:staff].name if row[:show_name] %></th>
          <% row[:cells].each do |cell| %>
            <% cell_class = cell[:state] == :confirmed ? "table-success" : cell[:state] == :draft ? "table-warning" : "" %>
            <td class="shift-cell shift-cell--<%= cell[:state] %> <%= cell_class %>"><%= cell[:label] %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="modal fade"
     id="exportModal"
     tabindex="-1"
     aria-labelledby="exportModalLabel"
     aria-hidden="true">

  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="exportModalLabel">
          CSVエクスポート
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="閉じる">
        </button>
      </div>

      <%= form_with url: export_work_requests_path,
                    method: :get,
                    data: { turbo: false } do |form| %>

        <div class="modal-body">
          <%= form.label :filename,
                         "ファイル名",
                         class: "form-label" %>

          <div class="input-group">
            <%= form.text_field :filename,
                                value: "シフト表_#{Time.current.strftime('%Y%m%d_%H%M')}",
                                class: "form-control",
                                required: true %>

            <span class="input-group-text">.csv</span>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            キャンセル
          </button>

          <%= form.submit "保存",
                          class: "btn btn-primary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
