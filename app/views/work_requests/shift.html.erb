<% content_for :title, "シフト表" %>

<table class="shift-table" border="1">
  <tr>
    <th></th>
    <th colspan="<%= @time_slots.size %>"><%= @date&.strftime("%-m/%-d") %></th>
  </tr>
  <tr>
    <th></th>
    <% @time_slots.each do |slot| %>
      <th><%= slot.strftime("%H:%M~") %></th>
    <% end %>
  </tr>
  <% @shift_rows.each do |row| %>
    <tr>
      <th><%= row[:staff].name if row[:show_name] %></th>
      <% row[:cells].each do |cell| %>
        <td class="shift-cell shift-cell--<%= cell[:state] %>"><%= cell[:label] %></td>
      <% end %>
    </tr>
  <% end %>
</table>
