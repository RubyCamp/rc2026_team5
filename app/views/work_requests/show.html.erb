<% content_for :title, @work_request.title %>

<p>
  <%= link_to(
        "勤務依頼一覧へ戻る",
        work_requests_path,
        class: "link-secondary"
      ) %>
</p>

<div
  class="
    d-flex
    flex-column
    flex-md-row
    justify-content-between
    align-items-md-start
    gap-3
    mb-4
  "
>
  <div>
    <p class="mb-1 text-primary fw-semibold">
      <%= @work_request.business.name %>
    </p>

    <h1 class="display-6 fw-git bold">
      <%= @work_request.title %>
    </h1>

    <p class="text-body-secondary">
      <%= l @work_request.starts_at, format: :long %>
      〜
      <%= l @work_request.ends_at, format: :long %>
    </p>
  </div>

  <span class="badge text-bg-primary">
    <%= enum_label(@work_request, :status) %>
  </span>
</div>

<!-- ---------------ボタンの場所、デザイン変更2026/09/02 -->
<div class="gap-3 mb-4 text-end">
<%= button_to "仮割当ボタン", {controller: 'work_requests', action: 'draft'}, {method: :get, params: {id: @work_request.id}, class: 'btn btn-primary '} %>
</div>
<!--  ---------------ボタンの場所、デザイン変更 END -->
<section class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 card-title">
      依頼条件
    </h2>

    <dl class="definition-list mb-0">

      <div>
        <dt>必要人数</dt>
        <dd>
          <%= @work_request.required_staff_count %>名
        </dd>
      </div>

      <div>
        <dt>必要スキル</dt>
        <dd>
          <%= @work_request.required_skill&.name ||
              "指定なし" %>
        </dd>
      </div>

      <div>
        <dt>割当済み</dt>
        <dd>
          <span id="work-request-assigned-count"><%= @work_request.assignments.size %></span>名
        </dd>
      </div>

    </dl>
  </div>
</section>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
      <h2 class="h4 card-title mb-0">備考</h2>
      <%= link_to "備考を編集", edit_work_request_path(@work_request), class: "btn btn-outline-primary" %>
    </div>

    <% if @work_request.notes.present? %>
      <%= simple_format @work_request.notes, class: "mb-0" %>
    <% else %>
      <p class="mb-0 text-body-secondary">備考はありません。</p>
    <% end %>
  </div>
</section>

<turbo-frame id="work-request-assignments">
<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h4 card-title">
      現在の割当
    </h2>

    <% if @work_request.assignments.any? %>
      <ul class="list-group list-group-flush">
        <% @work_request.assignments.each do |assignment| %>
          <li
            class="
              list-group-item
              px-0
              d-flex
              justify-content-between
              align-items-center
              gap-3
            "
          >
            <strong>
              <%= assignment.staff_member.name %>
            </strong>

            <span class="badge text-bg-secondary">
              <%= enum_label(assignment, :status) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mb-0 text-body-secondary">
        まだスタッフは割り当てられていません。
      </p>

    <% end %>


  </div>
</section>
</turbo-frame>

<!-- 仮割当の結果はshowページに表示するため、ここでは確認だけ行う。 -->
<button type="button" class="btn btn-primary mt-4" data-bs-toggle="modal" data-bs-target="#draftAssignmentModal">
  仮割当
</button>

<!-- ポップアップ部分 -->
<div class="modal fade" id="draftAssignmentModal" tabindex="-1" aria-labelledby="draftAssignmentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="draftAssignmentModalLabel">仮割当の確認</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body" id="draft-assignment-result">
        仮割当を実行しますか？
      </div>
      <div class="modal-footer" id="draft-assignment-modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
        <!-- GETで既存の仮割当処理を呼び、割当欄だけを更新する。 -->
        <%= link_to "実行する", draft_path(id: @work_request.id), class: "btn btn-primary", data: { turbo_stream: true } %>
      </div>
    </div>
  </div>
</div>
