<% content_for :title, "Rails開発チュートリアル" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    プロフィール
  </p>

  <h1 class="display-6 fw-bold">
    Rails開発チュートリアル
  </h1>

  <p class="page-lead text-body-secondary">
    好きなことやひとことから、メンバーについて知ってみましょう。
  </p>
</div>

<div class="d-flex align-items-center gap-2 mb-4">
  <span class="fw-semibold">表示件数</span>
  <span class="badge rounded-pill text-bg-primary">
    <%= @profiles.size %>件
  </span>
</div>

<%= form_with url: tutorial_path, method: :get do |form| %>
  <%= form.search_field :q, value: params[:q] %>
  <%= form.submit "Search" %>
<% end %>

<div class="row g-4">
  <% @profiles.each do |profile| %>
    <div class="col-12 col-md-6 col-xl-4">
      <article class="card h-100 shadow-sm">
        <div class="card-body">
          <div
            class="
              d-flex
              justify-content-between
              align-items-center
              gap-3
              mb-3
            "
          >
            <span class="badge text-bg-secondary">
              <%= profile.category %>
            </span>

            <span
              class="badge <%= profile.published ?
                "text-bg-success" : "text-bg-light" %>"
            >
              <%= profile.published ? "公開" : "非公開" %>
            </span>
          </div>

          <h2 class="h5 card-title mb-3">
            <%= profile.name %>
          </h2>

          <dl class="definition-list mb-0">
            <div>
              <dt>ID</dt>
              <dd><%= profile.id %></dd>
            </div>

            <div>
              <dt>ひとこと</dt>
              <dd><%= profile.message %></dd>
            </div>

            <div>
              <dt>好きなもの</dt>
              <dd><%= profile.favorite %></dd>
            </div>
          </dl>
        </div>
      </article>
    </div>
  <% end %>
</div>
